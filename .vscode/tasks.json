{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Smart Campus API",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"server",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Smart Campus API listening on http://localhost:4000"
				}
			}
		},
		{
			"label": "Run Smart Campus frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"client",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"dependsOn": [
				"Run Smart Campus API"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}